#!/usr/bin/env sh
set -eu

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

# Keep the vendored workpaper-kit copies in lockstep with the canonical source.
# Regenerate them and stage them so they ride the same commit. The copies are
# generated-only and are distinct files from the canonical source, so re-adding
# them cannot clobber a partially staged change.
if [ -f workpaper-kit/sync.sh ]; then
  bash workpaper-kit/sync.sh
  git add get-yearly-fx-rate/scripts/_workpaper.py get-year-end-fx-rate/scripts/_workpaper.py statements-to-interest/scripts/_workpaper.py
fi

# Keep the native FBAR plugin's three generated skill copies synchronized with
# their canonical top-level packages before privacy scanning and committing.
if [ -f scripts/sync-plugin-bundles.py ]; then
  python3 scripts/sync-plugin-bundles.py
  git add plugins/fbar-proof-kit/skills plugins/fbar-proof-kit/assets plugins/fbar-proof-kit/BUNDLE-MANIFEST.json
fi

python3 privacy-gate/scripts/privacy_gate.py scan --staged --strict
